iv id="navigation"> <a href="/jobs/?page=2&only_html=True&keywords=UI+UX"></a> </div> </div> <div style="display: none;" class="page-load-status"> <div class="infinite-scroll-request" id="infscr-loading"> <div style="display: flex; justify-content: center; flex-direction: column; text-align: center;"> <img style="margin: auto" width="30" height="30" src="https://assets.powertofly.com/assets/acc930df/static/dist/images/loader.gif" alt="Loading..."> <div>Loading more jobs...</div> </div> </div> <p style="display: none;" class="infinite-scroll-last text center">No more jobs to load</p> <p style="display: none;" class="infinite-scroll-error text center">No more jobs to load</p> </div> </div> </div> </div> <div class="job-details-wrapper jobs-list-column element-scroll"> <div class="job-details-container"> <div class="visible-md visible-lg"> <link href="https://assets.powertofly.com/assets/acc930df/static/dist/job-detail-manager-view.css" rel="stylesheet" data-viewport-units-buggyfill="ignore"> <script src="https://assets.powertofly.com/assets/acc930df/static/dist/job-detail-manager-view.js" defer></script> <div class="job-details-container job-public-page js-job-detail" data-job-id="2480509"> <div class="fixed-job-panel hide-on-desktop" id="fixedJobPanel"> <div class="fixed-job-panel__content"> <div class="fixed-job-panel__info"> <div class="fixed-job-panel__title">UI/UX Developer</div> <p class="fixed-job-panel__company">Morgan Stanley</p> </div> <div class="fixed-job-panel__actions"> <div class="job-apply job-apply-2480509" id="job-apply-2480509"> <div class="apply-row"> <button class="colored brand-cyan round btn btn-apply action-job-apply
                             stat-i-am-intersted-btn js-i-am-interested-btn" data-job-id="2480509" data-job-title="UI/UX Developer" data-company-id="3697" data-is-custom-link="true" action="/jobs/apply/unauth_apply?jid=2480509&confirm=1" data-api="ajax.popup" type="button"> <strong>Apply&nbsp;Now</strong> </button> <a class="save-job details-save-btn light-gray outlined btn" href="https://powertofly.com/entry/login?jobId=2480509&saveJob=true" id="savJobBtn-2480509" data-job-id="2480509"> <span class="icon icon-bookmark-empty"> <span>Save&nbsp;Job</span> </span> </a> </div> </div> </div> </div> </div> <div class="close-details-view hidden-md hidden-lg"> <button class="close-details-view__btn"><img src="https://assets.powertofly.com/assets/acc930df/static/dist/images/job-search-icons/back.svg" alt="Back to Results"></button> </div> <div class="header"> <div class="company-info-wrapper"> <a class="stat-i-am-intersted-company-btn company-media" data-company-id="3697" href="/companies/morgan-stanley" target="_blank"> <img data-src="https://assets.powertofly.com/thumbnail/4f22848479e447518bae82ea59e27f4a.jpeg" src="https://assets.powertofly.com/assets/acc930df/static/dist/images/default-img-sq.png" class="img lazy rounded" height="28" width="28" alt> <strong>Morgan Stanley</strong> </a> <h2 class="title" title="UI/UX Developer"> <a href="/jobs/detail/2480509" target="_blank">UI/UX Developer</a> </h2> <div class="params"> <span>Onsite</span> <span class="item">Budapest, Hungary</span> <span class="item"> <span>Full Time</span> </span> <span class="item"> <span>Senior</span> </span> <div class="item"> <span class="date">Posted <span content="2026-01-08 16:15:38.567431">20 days ago</span> </span> </div> </div> <div class="job-save-container"> <div class="job-apply job-apply-2480509" id="job-apply-2480509"> <div class="apply-row"> <button class="colored brand-cyan round btn btn-apply action-job-apply
                             stat-i-am-intersted-btn js-i-am-interested-btn" data-job-id="2480509" data-job-title="UI/UX Developer" data-company-id="3697" data-is-custom-link="true" action="/jobs/apply/unauth_apply?jid=2480509&confirm=1" data-api="ajax.popup" type="button"> <strong>Apply&nbsp;Now</strong> </button> <a class="save-job details-save-btn light-gray outlined btn" href="https://powertofly.com/entry/login?jobId=2480509&saveJob=true" id="savJobBtn-2480509" data-job-id="2480509"> <span class="icon icon-bookmark-empty"> <span>Save&nbsp;Job</span> </span> </a> </div> </div> </div> </div> </div> <div class="after-applying-wrapper"> <div class="content"> <div id="share-buttons-parent"> <div class="about"> <div id="job-description" class="description"> <h3 class="xxlg text margin-bottom"><strong>Job Details</strong></h3> <div class="pure-content redactor-theme-new view" style="word-break: break-word;"> <div></div><div><p>We're seeking someone to join our team as UI/UX Developer as part of the Sustainable Finance and Resilience Technology Department, within Non-Financial Risk Technology which sits in the division of Cyber, Risk, Resilience &amp; Data.</p><p></p><p>The ideal candidate will:</p><ul><li><p>Approach problems from a user’s perspective, understanding pain points and motivations to develop solutions that keep the user front and centre.</p></li><li><p>Partner closely with our UX Design Lead, proactively suggesting improvements from a development standpoint that can accelerate solution deployment, including leveraging AI technologies where appropriate.</p></li><li><p>Have prior experience collaborating with design teams to enhance usability and deliver intuitive, high-quality interfaces.</p></li></ul><p></p><p>The candidate will be a core part of the global team focusing on initiatives supporting our Firmwide Global Sustainability Office (GSO)—an exciting programme leveraging cutting-edge technologies to build capabilities that help the Firm meet its net zero carbon emissions targets, support advanced analysis of geospatial data and the impact of climate change on the Firm’s clients’ portfolios and its own investments, and provide data to our climate scientists and research teams.</p><p></p><p>The candidate will be part of a team of 7 developers in our Budapest office who will primarily be working on key departmental initiatives. The candidate will be expected to perform hands-on development daily across all phases of the software development lifecycle.</p><p></p><p>The candidate will collaborate closely with architects and other developers within the squads and with stakeholders, users, product owners and other squads involved in product delivery across the broader technology division and time zones to design, develop, test and deploy new and enhanced capabilities. The candidate will also be expected to make contributions to the objectives of the broader department.</p><p></p><p>The candidate should be a strong technical JavaScript (ES6+), and TypeScript developer, with expertise in the full SDLC process. Candidates will require strong design and implementation fundamentals. Prior experience in developing ESG solutions are valued, but the ability and willingness to quickly master new technical and business concepts are essential. The candidate will be working with an energetic team of highly intellectual and creative developers who work on innovative projects using a variety of different technologies.</p><p></p><p>The ideal candidate should have the skills listed below, should be a self-driven, dedicated individual who can innovate and work well in a team, and who can think and act strategically.</p><p>In the Technology division, we leverage innovation to build the connections and capabilities that power our Firm, enabling our clients and colleagues to redefine markets and shape the future of our communities. This is a Director position within our Global Sustainability Office (GSO) Technology function which comes with responsibilities for managing multiple products enabling sustainable finance and investing solutions across the Firm's business segments.<br><br>Morgan Stanley is an industry leader in financial services, known for mobilizing capital to help governments, corporations, institutions, and individuals around the world achieve their financial goals.<br>Interested in joining a team that's eager to create, innovate and make an impact on the world? Read on.<br><br><b>What you'll do in the role:</b></p><p>· Design and implement user-friendly, visually appealing, and responsive interfaces for web applications.</p><p>· Perform hands-on development and deliver high-quality digital experiences aligned with business goals.</p><p>· Stay up to date with emerging front-end technologies and best practices, and apply them to enhance our processes so we can keep pace with innovation in the field.</p><p>· Collaborate with UX designers, backend developers, and product teams across time zones.</p><p>· Translate design mock-ups and wireframes into functional UI components.</p><p>· Optimise applications for speed, scalability, and accessibility (WCAG compliance).</p><p>· Conduct usability testing and troubleshoot UI issues across browsers and devices.</p><p>· Contribute to technical architecture and roadmaps for mission-critical systems.</p><p>· Work within agile methodologies and help foster an effective engineering culture.</p><p></p><p><b>What you'll bring to the role:</b><br>· 5+ years of hands-on application development experience with strong proficiency in HTML5, CSS3, JavaScript (ES6+), and TypeScript. </p><p>· Experience with modern frameworks such as React, Angular, or Vue.js. </p><p>· Familiarity with version control systems (Git) and CI/CD pipelines. </p><p>· Solid understanding of UI/UX principles and accessibility standards. </p><p>· Expertise in responsive design, cross-browser compatibility, and UI performance optimisation. </p><p>· Excellent communication skills and ability to engage with stakeholders effectively.<br><br><b>Preferred skills &amp; experience:</b></p><p>· Experience with design tools (Figma, Adobe XD). </p><p>· Exposure to state management libraries (Redux, NgRx). </p><p>· Knowledge of testing frameworks (Jasmine, Jest) and agile practices. </p><p>· Familiarity with cloud deployment environments and DevOps. </p><p>· Experience with ESG or sustainability initiatives in financial services. </p><p>· Background in geospatial data processing or climate analysis, including MNPI-type data. </p><p>· Knowledge of data analytics. </p><p>· Experience with Python (REST/JSON frameworks), Java, or C#.</p><p></p> #LI-FT1 #BPTECH #LI-hybrid</div><p></p><p></p><p><b>WHAT YOU CAN EXPECT FROM MORGAN STANLEY:</b> </p><p></p><p> At Morgan Stanley, we raise, manage and allocate capital for our clients – helping them reach their goals. We do it in a way that’s differentiated – and we’ve done that for 90 years.  Our values - putting clients first, doing the right thing, leading with exceptional ideas, committing to diversity and inclusion, and giving back - aren’t just beliefs, they guide the decisions we make every day to do what's best for our clients, communities and more than 80,000 employees in 1,200 offices across 42 countries. At Morgan Stanley, you’ll find an opportunity to work alongside the best and the brightest, in an environment where you are supported and empowered. Our teams are relentless collaborators and creative thinkers, fueled by their diverse backgrounds and experiences. We are proud to support our employees and their families at every point along their work-life journey, offering some of the most attractive and comprehensive employee benefits and perks in the industry. There’s also ample opportunity to move about the business for those who show passion and grit in their work. </p><p></p><p>To learn more about our offices across the globe, please copy and paste https://www.morganstanley.com/about-us/global-offices​ into your browser.</p><p></p><p></p><p><b>Certified Persons Regulatory Requirements: </b><br>If this role is deemed a Certified role and may require the role holder to hold mandatory regulatory qualifications or the minimum qualifications to meet internal company benchmarks. <br><br><b>Flexible work statement </b><br>Interested in flexible working opportunities? Morgan Stanley empowers employees to have greater freedom of choice through flexible working arrangements. Speak to our recruitment team to find out more.<br><br>Morgan Stanley is an equal opportunities employer. We work to provide a supportive and inclusive environment where all individuals can maximize their full potential. Our skilled and creative workforce is comprised of individuals drawn from a broad cross section of the global communities in which we operate and who reflect a variety of backgrounds, talents, perspectives, and experiences. Our strong commitment to a culture of inclusion is evident through our constant focus on recruiting, developing, and advancing individuals based on their skills and talents.</p> </div> </div> <div class="skills margin-bottom"> <div class="margin-bottom-xs"><strong>Required Skills</strong></div> <ul class="tags-list"> <li> <a href="/jobs/?keywords=JavaScript" class="tag"> JavaScript </a> </li> <li> <a href="/jobs/?keywords=TypeScript" class="tag"> TypeScript </a> </li> <li> <a href="/jobs/?keywords=HTML5" class="tag"> HTML5 </a> </li> <li> <a href="/jobs/?keywords=CSS3" class="tag"> CSS3 </a> </li> <li> <a href="/jobs/?keywords=React" class="tag"> React </a> </li> <li> <a href="/jobs/?keywords=Angular" class="tag"> Angular </a> </li> </ul> </div> <div> <div class="margin-bottom-xs"><strong>Company Details</strong></div> <div class="job-company"> <div class="company-info"> <div class="company-media"> <a class="stat-i-am-intersted-company-btn" data-company-id="3697" href="/companies/morgan-stanley" target="_blank"> <img data-src="https://assets.powertofly.com/thumbnail/4f22848479e447518bae82ea59e27f4a.jpeg" src="https://assets.powertofly.com/assets/acc930df/static/dist/images/default-img-sq.png" class="img lazy rounded" height="45" width="45" alt> </a> <div class="company-data"> <a class="company-name stat-i-am-intersted-company-btn" data-company-id="3697" href="/companies/morgan-stanley" target="_blank"> <strong>Morgan Stanley</strong> </a> <div><i class="icon icon-location-2"></i>&nbsp;<span class="item">New York City, NY, United States</span></div> </div> </div> <a href="/companies/morgan-stanley#jobs" title="Morgan Stanley jobs" target="_blank" class="btn outlined darker-gray xxs company-jobs stat-i-am-intersted-company-btn" data-company-id="3697"> Work at Morgan Stanley </a> </div> <p class="company-description">At Morgan Stanley, we raise, manage and allocate capital for our clients – helping them reach their goals. We do it in a way that’s differentiated... <a href="/companies/morgan-stanley" class="stat-i-am-intersted-company-btn" target="_blank">Read more</a></p> </div> </div> </div> </div> </div> </div> <div class="modal fade " data-api="ajax.popup" id="talent-job-apply-confirmation-2480509" role="dialog" aria-labelledby="talent-job-apply-confirmation-2480509-label" data-backdrop="static"> <div class="modal-dialog modal-sm"> <div class="modal-content"> <button type="button" class="close " data-dismiss="modal"> <span class="sr-only">Close</span> </button> <div class="body modal-body"> <div class="padding-left padding-right padding-top padding-bottom"> <div class="text-center text xxlg bold margin-bottom-lg"> Did you submit an application for the UI/UX Developer on the Morgan Stanley website? </div> <div class="text-center margin-bottom"> <button type="button" class="btn colored pink js-send-applied">Yes, I applied</button> </div> <div class="text-center"> <button type="button" class="btn link black js-send-not-applied">No, I didn’t apply</button> </div> </div> </div> </div> </div> </div> </div> <script>
$(document).ready(function() {
  const $fixedPanel = $("#fixedJobPanel")
  const $header = $(".job-details-container .header")

  if ($fixedPanel.length && $header.length) {
    let headerOffset = $header.offset().top + $header.outerHeight()
    let isPanelVisible = false

    // Watch for scroll events on the job-details-wrapper container
    const $scrollContainer = $(".job-details-wrapper")

    function handleScroll() {
      const scrollTop = $scrollContainer.scrollTop()

      if (scrollTop >= headerOffset && !isPanelVisible) {
        $fixedPanel.addClass("active")
        isPanelVisible = true
      } else if (scrollTop < headerOffset && isPanelVisible) {
        $fixedPanel.removeClass("active")
        isPanelVisible = false
      }
    }

    // Handle scroll events on the job details wrapper
    $scrollContainer.on("scroll.jobPanel", handleScroll)

    // Handle window resize to recalculate header position
    $(window).on("resize.jobPanel", function() {
      headerOffset = $header.offset().top + $header.outerHeight()
      handleScroll()
    })

    // Initial check
    handleScroll()

    // Cleanup when job details are closed
    $(document).on("click", ".close-details-view__btn", function() {
      $(window).off("scroll.jobPanel resize.jobPanel")
      $scrollContainer.off("scroll.jobPanel")
    })
